# Mode: DEMO | PAPER | SHADOW. LIVE modes are not available in this build.
MODE=PAPER
LIVE_ENABLED=false

# Postgres (source of truth)
DATABASE_URL=
TEST_DATABASE_URL=

# Read-only providers (server-side only, never in the browser bundle)
JUPITER_API_KEY=
HELIUS_API_KEY=
# Without HELIUS_API_KEY the public endpoint https://api.mainnet-beta.solana.com is used (no key).
SOLANA_RPC_URL=
HELIUS_WEBHOOK_AUTH=

# Owner panel / notifications
OWNER_PASSWORD_HASH=
SESSION_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# NEVER put a signing key here. PAPER/DEMO/SHADOW refuse to start if any
# *PRIVATE_KEY*, *SECRET_KEY*, *SEED_PHRASE*, *MNEMONIC*, *KEYPAIR*, SIGNER_* variable is set.
